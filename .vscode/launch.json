{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python 调试程序: 当前文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "debug all",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/test/test_unit",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "base test_unit"
    },
    {
      "name": "debug single",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/test/test_unit",
      "args": [
        "--gtest_filter=test_ppl.*" // test_*_cu.   test_batched_matmul_cu test_qwen3
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "base test_unit"
    },
    {
      "name": "qwen3_infer",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/demo/qwen3_infer",
      "args": [
        "${workspaceFolder}/tools/export_qwen3/qwen0.6.bin",
        "${workspaceFolder}/Qwen/Qwen3-0.6B/tokenizer_config.json",
        "cuda"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "build qwen3_infer"
    }
  ]
}